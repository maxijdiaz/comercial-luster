                        <td className="py-3 px-3 text-right text-teal-400">{row.planoAnual > 0 ? formatBRL(row.planoAnual) : '-'}</td>
                        <td className="py-3 px-3 text-center font-bold text-slate-200">{row.vendas}</td>
                        <td className="py-3 px-3 text-right font-bold text-cyan-400">{formatBRL(row.ticketMedio)}</td>
                        <td className="py-3 px-3 text-right">{row.convR.toFixed(1)}%</td>
                        <td className="py-3 px-3 text-right">{row.convQtd.toFixed(1)}%</td>
                        <td className="py-3 px-3 text-right">{row.m2.toLocaleString('pt-BR')} m²</td>
                        <td className="py-3 px-3 text-right">{formatBRL(row.rPorM2)}</td>
                      </tr>
                    ))}
                    {/* Linha de Totais Acumulados */}
                    <tr className="bg-slate-950 font-bold text-slate-100 border-t-2 border-slate-700">
                      <td className="py-3 px-3 font-sans">TOTAL 5 ANOS</td>
                      <td className="py-3 px-3 text-right">R$ 1.514.559,16</td>
                      <td className="py-3 px-3 text-center">300</td>
                      <td className="py-3 px-3 text-right text-emerald-400">R$ 476.653,74</td>
                      <td className="py-3 px-3 text-right text-teal-400">R$ 109.666,67</td>
                      <td className="py-3 px-3 text-center">126</td>
                      <td className="py-3 px-3 text-right text-cyan-400">R$ 3.782,97</td>
                      <td className="py-3 px-3 text-right">31,5%</td>
                      <td className="py-3 px-3 text-right">42,0%</td>
                      <td className="py-3 px-3 text-right">18.486 m²</td>
                      <td className="py-3 px-3 text-right">R$ 25,78</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        )}
      </main>

      {/* ======================================================== */}
      {/* MODAL: NOVO ORÇAMENTO / EDIÇÃO                           */}
      {/* ======================================================== */}
      {isModalOpen && (
        <div className="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto shadow-2xl p-6 space-y-4">
            <div className="flex items-center justify-between border-b border-slate-800 pb-3">
              <h3 className="text-base font-bold text-white flex items-center gap-2">
                <FileText className="w-5 h-5 text-cyan-400" />
                {editingDealId ? 'Editar Proposta Comercial' : 'Cadastrar Novo Orçamento / Negócio'}
              </h3>
              <button
                onClick={() => setIsModalOpen(false)}
                className="text-slate-400 hover:text-white p-1 rounded-lg"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <form onSubmit={handleSaveForm} className="space-y-4 text-xs">
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                {/* Cliente */}
                <div className="space-y-1">
                  <label className="text-slate-300 font-semibold">Nome do Cliente / Empresa *</label>
                  <input
                    type="text"
                    required
                    value={formData.cliente}
                    onChange={(e) => setFormData({ ...formData, cliente: e.target.value })}
                    placeholder="Ex: Farmácia São Bento"
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-cyan-500"
                  />
                </div>

                {/* Cidade */}
                <div className="space-y-1">
                  <label className="text-slate-300 font-semibold">Cidade / UF</label>
                  <input
                    type="text"
                    value={formData.cidade}
                    onChange={(e) => setFormData({ ...formData, cidade: e.target.value })}
                    placeholder="Ex: Araguaína"
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-cyan-500"
                  />
                </div>

                {/* Competência (Mês) */}
                <div className="space-y-1">
                  <label className="text-slate-300 font-semibold">Competência (Mês de Referência)</label>
                  <select
                    value={formData.competencia}
                    onChange={(e) => setFormData({ ...formData, competencia: e.target.value })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-cyan-500"
                  >
                    {MONTHS.map(m => <option key={m} value={m}>{m}</option>)}
                  </select>
                </div>

                {/* Ano */}
                <div className="space-y-1">
                  <label className="text-slate-300 font-semibold">Ano</label>
                  <select
                    value={formData.ano}
                    onChange={(e) => setFormData({ ...formData, ano: Number(e.target.value) })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-cyan-500"
                  >
                    <option value={2026}>2026</option>
                    <option value={2025}>2025</option>
                    <option value={2024}>2024</option>
                  </select>
                </div>

                {/* Serviço Principal */}
                <div className="space-y-1">
                  <label className="text-slate-300 font-semibold">Serviço / Escopo</label>
                  <select
                    value={formData.servico}
                    onChange={(e) => setFormData({ ...formData, servico: e.target.value })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-cyan-500"
                  >
                    {SERVICES.map(s => <option key={s} value={s}>{s}</option>)}
                  </select>
                </div>

                {/* Vendedor */}
                <div className="space-y-1">
                  <label className="text-slate-300 font-semibold">Vendedor / Responsável</label>
                  <select
                    value={formData.vendedor}
                    onChange={(e) => setFormData({ ...formData, vendedor: e.target.value })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-cyan-500"
                  >
                    {SELLERS.map(v => <option key={v} value={v}>{v}</option>)}
                  </select>
                </div>

                {/* M² e Checkbox M² Estimado */}
                <div className="space-y-1">
                  <label className="text-slate-300 font-semibold">Metragem da Fachada (m²)</label>
                  <div className="flex items-center gap-2">
                    <input
                      type="number"
                      min="0"
                      value={formData.m2}
                      onChange={(e) => setFormData({ ...formData, m2: Number(e.target.value) })}
                      className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-cyan-500 font-mono"
                    />
                    <label className="flex items-center gap-1.5 text-[11px] text-slate-400 whitespace-nowrap cursor-pointer">
                      <input
                        type="checkbox"
                        checked={formData.m2Estimado}
                        onChange={(e) => setFormData({ ...formData, m2Estimado: e.target.checked })}
                        className="rounded border-slate-700 text-cyan-500 focus:ring-0"
                      />
                      M² Estimado
                    </label>
                  </div>
                </div>

                {/* Status do Funil */}
                <div className="space-y-1">
                  <label className="text-slate-300 font-semibold">Status do Funil</label>
                  <select
                    value={formData.status}
                    onChange={(e) => {
                      const st = e.target.value;
                      setFormData({
                        ...formData,
                        status: st,
                        vendaEfetiva: st === 'Serviço Entregue' || st === 'Contrato Fechado'
                      });
                    }}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-cyan-500"
                  >
                    {STATUSES.map(s => <option key={s} value={s}>{s}</option>)}
                  </select>
                </div>

                {/* Valor Spot / Revitalização */}
                <div className="space-y-1">
                  <label className="text-slate-300 font-semibold">Valor Spot / Revitalização (R$)</label>
                  <input
                    type="number"
                    step="0.01"
                    min="0"
                    value={formData.valorRevit}
                    onChange={(e) => setFormData({ ...formData, valorRevit: Number(e.target.value) })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-cyan-500 font-mono"
                  />
                </div>

                {/* Valor Plano Anual */}
                <div className="space-y-1">
                  <label className="text-slate-300 font-semibold">Valor Contrato Plano Anual (R$)</label>
                  <input
                    type="number"
                    step="0.01"
                    min="0"
                    value={formData.valorPlanoAnual}
                    onChange={(e) => setFormData({ ...formData, valorPlanoAnual: Number(e.target.value) })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-cyan-500 font-mono"
                  />
                </div>
              </div>

              {/* Prévia do Valor Total Calculado */}
              <div className="p-3 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between">
                <span className="text-slate-400 font-medium">Valor Total da Proposta:</span>
                <span className="text-base font-bold text-cyan-400 font-mono">
                  {formatBRL((Number(formData.valorRevit) || 0) + (Number(formData.valorPlanoAnual) || 0))}
                </span>
              </div>

              {/* Flags de Venda Efetiva e NF */}
              <div className="flex items-center gap-6 pt-2">
                <label className="flex items-center gap-2 cursor-pointer text-slate-300">
                  <input
                    type="checkbox"
                    checked={formData.vendaEfetiva}
                    onChange={(e) => setFormData({ ...formData, vendaEfetiva: e.target.checked })}
                    className="w-4 h-4 rounded border-slate-700 text-emerald-500 focus:ring-0"
                  />
                  <span>Venda Efetiva Fechada</span>
                </label>

                <label className="flex items-center gap-2 cursor-pointer text-slate-300">
                  <input
                    type="checkbox"
                    checked={formData.nf}
                    onChange={(e) => setFormData({ ...formData, nf: e.target.checked })}
                    className="w-4 h-4 rounded border-slate-700 text-blue-500 focus:ring-0"
                  />
                  <span>Nota Fiscal Emitida (Simples 6%)</span>
                </label>
              </div>

              {/* Botões do Rodapé */}
              <div className="flex justify-end gap-2 pt-4 border-t border-slate-800">
                <button
                  type="button"
                  onClick={() => setIsModalOpen(false)}
                  className="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold"
                >
                  Cancelar
                </button>
                <button
                  type="submit"
                  className="px-5 py-2 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold transition shadow-lg shadow-cyan-950/50"
                >
                  {editingDealId ? 'Salvar Alterações' : 'Cadastrar Negócio'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Footer */}
      <footer className="border-t border-slate-900 bg-slate-950 py-4 px-4 text-center text-xs text-slate-500">
        Lüster Fachadas • Sistema de Gestão Comercial e Inteligência de Vendas • Dados reconciliados 2022–2026
      </footer>
    </div>
  );
}
