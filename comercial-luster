export default function App() {
  // Estado principal dos negócios com persistência LocalStorage
  const [deals, setDeals] = useState(() => {
    try {
      const saved = localStorage.getItem('luster_deals_v2');
      if (saved) return JSON.parse(saved);
    } catch (e) {
      console.error(e);
    }
    return INITIAL_DEALS;
  });

  useEffect(() => {
    try {
      localStorage.setItem('luster_deals_v2', JSON.stringify(deals));
    } catch (e) {
      console.error(e);
    }
  }, [deals]);

  // Controles de Visualização e Filtros
  const [currentTab, setCurrentTab] = useState('dashboard'); // 'dashboard' | 'table' | 'kanban' | 'simulator' | 'history'
  const [selectedYear, setSelectedYear] = useState('2026');
  const [filterMonth, setFilterMonth] = useState('TODOS');
  const [filterStatus, setFilterStatus] = useState('TODOS');
  const [filterSeller, setFilterSeller] = useState('TODOS');
  const [searchTerm, setSearchTerm] = useState('');

  // Estado do Modal de Cadastro/Edição
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [editingDealId, setEditingDealId] = useState(null);
  const [formData, setFormData] = useState({
    cliente: '',
    cidade: 'Araguaína',
    competencia: 'NOV',
    ano: 2026,
    m2: 50,
    m2Estimado: false,
    valorRevit: 5000,
    valorPlanoAnual: 0,
    status: 'Orçamento Entregue',
    vendaEfetiva: false,
    nf: false,
    vendedor: 'Max',
    servico: 'Revitalização ACM',
    data: new Date().toISOString().split('T')[0]
  });

  // Notificações Toast
  const [toast, setToast] = useState(null);
  const showToast = (message, type = 'success') => {
    setToast({ message, type });
    setTimeout(() => setToast(null), 3500);
  };

  // Restaurar dados originais
  const handleResetData = () => {
    if (window.confirm("Deseja realmente restaurar os dados originais da planilha? Todas as alterações salvas serão substituídas.")) {
      setDeals(INITIAL_DEALS);
      showToast("Dados originais da planilha restaurados com sucesso!");
    }
  };

  // Filtragem dos registros
  const filteredDeals = useMemo(() => {
    return deals.filter(item => {
      if (selectedYear !== 'TODOS' && item.ano !== Number(selectedYear)) return false;
      if (filterMonth !== 'TODOS' && item.competencia !== filterMonth) return false;
      if (filterStatus !== 'TODOS' && item.status !== filterStatus) return false;
      if (filterSeller !== 'TODOS' && item.vendedor !== filterSeller) return false;
      if (searchTerm.trim() !== '') {
        const query = searchTerm.toLowerCase();
        const matchClient = item.cliente?.toLowerCase().includes(query);
        const matchCity = item.cidade?.toLowerCase().includes(query);
        const matchService = item.servico?.toLowerCase().includes(query);
        if (!matchClient && !matchCity && !matchService) return false;
      }
      return true;
    });
  }, [deals, selectedYear, filterMonth, filterStatus, filterSeller, searchTerm]);

  // Cálculos de Indicadores Chave (sem dupla contagem!)
  const stats = useMemo(() => {
    const list = filteredDeals;
    const totalOrcamentos = list.length;
    const totalOrcado = list.reduce((acc, d) => acc + (Number(d.valorTotal) || 0), 0);
    
    // Vendas fechadas
    const vendasFechadas = list.filter(d => d.vendaEfetiva);
    const qtdVendas = vendasFechadas.length;
    const totalVendido = vendasFechadas.reduce((acc, d) => acc + (Number(d.valorTotal) || 0), 0);
    const totalPlanoAnual = vendasFechadas.reduce((acc, d) => acc + (Number(d.valorPlanoAnual) || 0), 0);
    const faturadoDireto = totalVendido - totalPlanoAnual;

    // Metragem vendida
    const m2Vendido = vendasFechadas.reduce((acc, d) => acc + (Number(d.m2) || 0), 0);
    
    // Vendas com NF vs Sem NF
    const vendasComNF = vendasFechadas.filter(d => d.nf);
    const totalComNF = vendasComNF.reduce((acc, d) => acc + (Number(d.valorTotal) || 0), 0);
    const impostoSimples = totalComNF * 0.06; // Simples Nacional a 6%

    // Taxas corrigidas sem dupla contagem
    const ticketMedio = qtdVendas > 0 ? totalVendido / qtdVendas : 0;
    const convValorPct = totalOrcado > 0 ? (totalVendido / totalOrcado) * 100 : 0;
    const convVolumePct = totalOrcamentos > 0 ? (qtdVendas / totalOrcamentos) * 100 : 0;
